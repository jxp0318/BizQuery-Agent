  SUM(CASE WHEN d.date_id BETWEEN 20250101 AND 20250331 THEN f.order_amount ELSE 0 END) AS GMV_2025Q1,
  SUM(CASE WHEN d.date_id BETWEEN 20240101 AND 20240331 THEN f.order_amount ELSE 0 END) AS GMV_2024Q1,
  SUM(CASE WHEN d.date_id BETWEEN 20250101 AND 20250331 THEN f.order_amount ELSE 0 END) / NULLIF(SUM(CASE WHEN d.date_id BETWEEN 20240101 AND 20240331 THEN f.order_amount ELSE 0 END), 0) AS GMV_2025Q1_与_2024Q1_比值
FROM fact_order f
JOIN dim_date d ON f.date_id = d.date_id
WHERE d.date_id BETWEEN 20240101 AND 20250331;
