  SUM(CASE WHEN d.date_id >= 20251201 AND d.date_id <= 20251231 THEN f.order_amount ELSE 0 END) AS GMV_2025年12月,
  SUM(CASE WHEN d.date_id >= 20241201 AND d.date_id <= 20241231 THEN f.order_amount ELSE 0 END) AS GMV_2024年12月,
  (SUM(CASE WHEN d.date_id >= 20251201 AND d.date_id <= 20251231 THEN f.order_amount ELSE 0 END) - SUM(CASE WHEN d.date_id >= 20241201 AND d.date_id <= 20241231 THEN f.order_amount ELSE 0 END)) / NULLIF(SUM(CASE WHEN d.date_id >= 20241201 AND d.date_id <= 20241231 THEN f.order_amount ELSE 0 END), 0) AS 同比增长率
FROM fact_order f
JOIN dim_date d ON f.date_id = d.date_id
WHERE (d.date_id >= 20241201 AND d.date_id <= 20241231)
   OR (d.date_id >= 20251201 AND d.date_id <= 20251231);
