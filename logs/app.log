2026-09-27 11:54:41.718 | INFO     | request_id - 186a0009-797d-4a12-aca0-b8d7a5fca4aa | app.agent.nodes.generate_sql:generate_sql:63 - 生成的SQL：SELECT
  d2025.quarter AS quarter,
  SUM(CASE WHEN d2025.year = 2025 THEN f2025.order_amount ELSE 0 END) AS GMV_2025Q4,
  SUM(CASE WHEN d2024.year = 2024 THEN f2024.order_amount ELSE 0 END) AS GMV_2024Q4,
  (SUM(CASE WHEN d2025.year = 2025 THEN f2025.order_amount ELSE 0 END) - SUM(CASE WHEN d2024.year = 2024 THEN f2024.order_amount ELSE 0 END)) / NULLIF(SUM(CASE WHEN d2024.year = 2024 THEN f2024.order_amount ELSE 0 END), 0) AS YoY
FROM dim_date d2025
JOIN fact_order f2025 ON f2025.date_id = d2025.date_id
JOIN dim_date d2024 ON d2024.quarter = d2025.quarter
JOIN fact_order f2024 ON f2024.date_id = d2024.date_id
WHERE d2025.quarter = 'Q4'
  AND d2025.year = 2025
  AND d2024.year = 2024
GROUP BY d2025.quarter;
