2026-09-27 11:54:46.485 | INFO     | request_id - 1cd813e3-ca82-4122-83d6-2dbfaf3f3a26 | app.agent.nodes.generate_sql:generate_sql:63 - 生成的SQL：SELECT
  dd.quarter AS 季度,
  SUM(CASE WHEN dd.date_id >= 20250101 AND dd.date_id <= 20250331 THEN fo.order_amount ELSE 0 END) AS 2025年Q1_GMV,
  SUM(CASE WHEN dd.date_id >= 20240101 AND dd.date_id <= 20240331 THEN fo.order_amount ELSE 0 END) AS 2024年Q1_GMV,
  (SUM(CASE WHEN dd.date_id >= 20250101 AND dd.date_id <= 20250331 THEN fo.order_amount ELSE 0 END) - SUM(CASE WHEN dd.date_id >= 20240101 AND dd.date_id <= 20240331 THEN fo.order_amount ELSE 0 END)) / NULLIF(SUM(CASE WHEN dd.date_id >= 20240101 AND dd.date_id <= 20240331 THEN fo.order_amount ELSE 0 END), 0) AS 同比增长率
FROM fact_order fo
JOIN dim_date dd ON fo.date_id = dd.date_id
WHERE dd.quarter = 'Q1'
  AND ((dd.date_id >= 20240101 AND dd.date_id <= 20240331) OR (dd.date_id >= 20250101 AND dd.date_id <= 20250331))
GROUP BY dd.quarter;
