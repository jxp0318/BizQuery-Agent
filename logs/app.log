2026-09-27 11:04:06.192 | INFO     | request_id - 29b46c1f-23e8-4a71-8f2b-9376da9685dc | app.agent.nodes.generate_sql:generate_sql:63 - 生成的SQL：SELECT
  SUM(CASE WHEN d.date_id >= 20250101 AND d.date_id <= 20251231 THEN f.order_amount ELSE 0 END) AS GMV_2025,
  SUM(CASE WHEN d.date_id >= 20240101 AND d.date_id <= 20241231 THEN f.order_amount ELSE 0 END) AS GMV_2024,
  SUM(CASE WHEN d.date_id >= 20250101 AND d.date_id <= 20251231 THEN f.order_amount ELSE 0 END)
    - SUM(CASE WHEN d.date_id >= 20240101 AND d.date_id <= 20241231 THEN f.order_amount ELSE 0 END) AS GMV_同比增量,
  (SUM(CASE WHEN d.date_id >= 20250101 AND d.date_id <= 20251231 THEN f.order_amount ELSE 0 END)
    - SUM(CASE WHEN d.date_id >= 20240101 AND d.date_id <= 20241231 THEN f.order_amount ELSE 0 END))
    / NULLIF(SUM(CASE WHEN d.date_id >= 20240101 AND d.date_id <= 20241231 THEN f.order_amount ELSE 0 END), 0) AS GMV_同比增长率
FROM fact_order f
JOIN dim_date d ON f.date_id = d.date_id
JOIN dim_region r ON f.region_id = r.region_id
WHERE r.region_name = '华东'
  AND ((d.date_id >= 20240101 AND d.date_id <= 20241231) OR (d.date_id >= 20250101 AND d.date_id <= 20251231));
