2026-09-24 19:02:46.535 | INFO     | request_id - 62de115c-f617-4e67-a5aa-693a92c3d0fe | app.agent.nodes.generate_sql:generate_sql:63 - 生成的SQL：SELECT
  SUM(CASE WHEN d.year = 2024 AND d.quarter = 'Q1' THEN f.order_amount ELSE 0 END) AS gmv_2024_q1,
  SUM(CASE WHEN d.year = 2025 AND d.quarter = 'Q1' THEN f.order_amount ELSE 0 END) AS gmv_2025_q1,
  ROUND(
    (
      SUM(CASE WHEN d.year = 2025 AND d.quarter = 'Q1' THEN f.order_amount ELSE 0 END)
      - SUM(CASE WHEN d.year = 2024 AND d.quarter = 'Q1' THEN f.order_amount ELSE 0 END)
    )
    / NULLIF(SUM(CASE WHEN d.year = 2024 AND d.quarter = 'Q1' THEN f.order_amount ELSE 0 END), 0)
    * 100,
    2
  ) AS yoy_growth_rate_percent
FROM fact_order AS f
JOIN dim_date AS d
  ON f.date_id = d.date_id
WHERE d.year IN (2024, 2025)
  AND d.quarter = 'Q1';
